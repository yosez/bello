Grammar

    0 $accept: begin_stream $end

    1 begin_stream: import_statement
    2             | statement

    3 import_statement: IMPORT STR_LTR

    4 @1: /* empty */

    5 statement: statement monostatement @1 enclose_statement_stack build_single_statement_stack execute_single_statement LF
    6          | statement foldable_statement build_statement_stack LF

    7 @2: /* empty */

    8 statement: statement close_execute_last_statement @2 single_statement LF check_indent build_statement_stack execute_single_statement
    9          | statement INDENT single_statement LF check_indent build_statement_stack
   10          | statement LF close_execute_statement
   11          | statement END_FILE close_execute_last_statement
   12          | error
   13          | END_FILE

   14 check_indent: /* empty */

   15 enclose_statement_stack: /* empty */

   16 build_statement_stack: /* empty */

   17 build_single_statement_stack: /* empty */

   18 close_execute_statement: /* empty */

   19 close_execute_last_statement: /* empty */

   20 execute_single_statement: /* empty */

   21 monostatement: expression_statement
   22              | break_statement
   23              | continue_statement
   24              | return_statement
   25              | nop_statement
   26              | var_statement
   27              | global_statement

   28 foldable_statement: function_statement
   29                   | for_statement
   30                   | class_statement
   31                   | while_statement

   32 single_statement: expression_statement
   33                 | if_statement
   34                 | else_statement
   35                 | elif_statement
   36                 | for_statement
   37                 | while_statement
   38                 | break_statement
   39                 | continue_statement
   40                 | return_statement
   41                 | function_statement
   42                 | nop_statement
   43                 | var_statement
   44                 | global_statement
   45                 | class_statement
   46                 | error

   47 single_statement_no_semicolon: expression_statement
   48                              | if_statement
   49                              | for_statement
   50                              | while_statement
   51                              | do_while_statement
   52                              | null_statement

   53 null_statement: /* empty */

   54 nop_statement: NOP

   55 statement_block: LEFT_BRACE block_list RIGHT_BRACE
   56                | LEFT_BRACE RIGHT_BRACE

   57 block_list: single_statement
   58           | block_list single_statement

   59 expression_statement: expression

   60 expression: value_expression
   61           | lvalue_operation_expression
   62           | unary_expression
   63           | binary_expression
   64           | array_expression
   65           | shortcut_expression

   66 lvalue_operation_expression: assign_expression
   67                            | self_operation_expression

   68 assign_expression: lvalue_expression ASSIGN expression
   69                  | lvalue_expression ADD_ASSIGN expression
   70                  | lvalue_expression SUB_ASSIGN expression
   71                  | lvalue_expression MUL_ASSIGN expression
   72                  | lvalue_expression DIV_ASSIGN expression
   73                  | lvalue_expression MOD_ASSIGN expression

   74 self_operation_expression: INCREMENT lvalue_expression
   75                          | DECREMENT lvalue_expression
   76                          | lvalue_expression INCREMENT
   77                          | lvalue_expression DECREMENT

   78 unary_expression: SUB expression
   79                 | ADD expression
   80                 | LEFT_PAREN expression RIGHT_PAREN
   81                 | NOT expression
   82                 | BIT_NOT expression

   83 binary_expression: expression ADD expression
   84                  | expression SUB expression
   85                  | expression MUL expression
   86                  | expression DIV expression
   87                  | expression MOD expression
   88                  | expression AND expression
   89                  | expression OR expression
   90                  | expression XOR expression
   91                  | expression EQ expression
   92                  | expression NE expression
   93                  | expression GT expression
   94                  | expression GE expression
   95                  | expression LT expression
   96                  | expression LE expression
   97                  | expression BIT_AND expression
   98                  | expression BIT_OR expression
   99                  | expression BIT_XOR expression
  100                  | expression QM expression COLON expression

  101 shortcut_expression: SHORTCUT_PRINTLN element_list

  102 value_expression: INT_LTR
  103                 | FLT_LTR
  104                 | BLN_LTR
  105                 | STR_LTR
  106                 | NLL_LTR
  107                 | function_expression
  108                 | lvalue_expression

  109 lvalue_expression: IDENTIFER
  110                  | lvalue_expression DOT IDENTIFER
  111                  | lvalue_expression evaluate_list
  112                  | lvalue_expression DOT function_expression

  113 array_expression: LEFT_QUAD element_list RIGHT_QUAD
  114                 | LEFT_QUAD RIGHT_QUAD

  115 element_list: expression
  116             | element_list COMMA expression

  117 var_statement: VAR assign_list
  118              | SHARED VAR assign_list

  119 global_statement: GLOBAL assign_list

  120 assign_list: IDENTIFER
  121            | IDENTIFER ASSIGN expression
  122            | assign_list COMMA IDENTIFER
  123            | assign_list COMMA IDENTIFER ASSIGN expression

  124 function_expression: IDENTIFER LEFT_PAREN argument_list RIGHT_PAREN
  125                    | IDENTIFER LEFT_PAREN RIGHT_PAREN

  126 argument_list: expression
  127              | IDENTIFER COLON expression
  128              | argument_list COMMA expression
  129              | argument_list COMMA IDENTIFER COLON expression

  130 parameter_list: IDENTIFER
  131               | IDENTIFER ASSIGN expression
  132               | parameter_list COMMA IDENTIFER
  133               | parameter_list COMMA IDENTIFER ASSIGN expression

  134 evaluate_list: LEFT_QUAD expression RIGHT_QUAD
  135              | LEFT_QUAD expression COLON expression RIGHT_QUAD
  136              | LEFT_QUAD expression COLON expression COLON RIGHT_QUAD
  137              | LEFT_QUAD expression COLON expression COLON expression RIGHT_QUAD
  138              | LEFT_QUAD expression COLON RIGHT_QUAD
  139              | LEFT_QUAD expression COLON COLON RIGHT_QUAD
  140              | LEFT_QUAD expression COLON COLON expression RIGHT_QUAD
  141              | LEFT_QUAD COLON expression RIGHT_QUAD
  142              | LEFT_QUAD COLON expression COLON RIGHT_QUAD
  143              | LEFT_QUAD COLON expression COLON expression RIGHT_QUAD
  144              | LEFT_QUAD COLON COLON RIGHT_QUAD
  145              | evaluate_list LEFT_QUAD expression RIGHT_QUAD
  146              | evaluate_list LEFT_QUAD expression COLON expression RIGHT_QUAD
  147              | evaluate_list LEFT_QUAD expression COLON expression COLON RIGHT_QUAD
  148              | evaluate_list LEFT_QUAD expression COLON expression COLON expression RIGHT_QUAD
  149              | evaluate_list LEFT_QUAD expression COLON RIGHT_QUAD
  150              | evaluate_list LEFT_QUAD expression COLON COLON RIGHT_QUAD
  151              | evaluate_list LEFT_QUAD expression COLON COLON expression RIGHT_QUAD
  152              | evaluate_list LEFT_QUAD COLON expression RIGHT_QUAD
  153              | evaluate_list LEFT_QUAD COLON expression COLON RIGHT_QUAD
  154              | evaluate_list LEFT_QUAD COLON expression COLON expression RIGHT_QUAD
  155              | evaluate_list LEFT_QUAD COLON COLON RIGHT_QUAD

  156 if_statement: IF expression

  157 else_statement: ELSE

  158 elif_statement: ELIF expression

  159 for_statement: FOR single_statement_no_semicolon SEMICOLON expression_statement SEMICOLON single_statement_no_semicolon
  160              | FOR single_statement_no_semicolon COLON expression_statement COLON single_statement_no_semicolon

  161 while_statement: WHILE expression
  162                | WHILE

  163 do_while_statement: DO structure_statement WHILE LEFT_PAREN expression_statement RIGHT_PAREN SEMICOLON

  164 break_statement: BREAK
  165                | BREAK LEFT_PAREN expression RIGHT_PAREN

  166 continue_statement: CONTINUE
  167                   | CONTINUE LEFT_PAREN expression RIGHT_PAREN

  168 structure_statement: single_statement
  169                    | statement_block

  170 function_statement: FUNC IDENTIFER LEFT_PAREN parameter_list RIGHT_PAREN
  171                   | FUNC IDENTIFER LEFT_PAREN RIGHT_PAREN
  172                   | SHARED FUNC IDENTIFER LEFT_PAREN parameter_list RIGHT_PAREN
  173                   | SHARED FUNC IDENTIFER LEFT_PAREN RIGHT_PAREN

  174 class_statement: CLASS IDENTIFER

  175 return_statement: RETURN
  176                 | RETURN expression


