Grammar

    0 $accept: begin_stream $end

    1 begin_stream: import_statement
    2             | statement

    3 import_statement: IMPORT STR_LTR

    4 statement: statement NOINDENT monostatement enclose_statement_stack build_single_statement_stack execute_single_statement LF
    5          | statement NOINDENT foldable_statement build_statement_stack LF
    6          | statement INDENT single_statement LF check_indent build_statement_stack

    7 @1: /* empty */

    8 statement: statement close_execute_last_statement @1 single_statement LF check_indent build_statement_stack execute_single_statement
    9          | statement INDENT single_statement LF check_indent build_statement_stack
   10          | statement LF close_execute_statement
   11          | statement END_FILE close_execute_last_statement
   12          | error
   13          | END_FILE

   14 check_indent: /* empty */

   15 enclose_statement_stack: /* empty */

   16 build_statement_stack: /* empty */

   17 build_single_statement_stack: /* empty */

   18 close_execute_statement: /* empty */

   19 close_execute_last_statement: /* empty */

   20 execute_single_statement: /* empty */

   21 monostatement: expression_statement
   22              | break_statement
   23              | continue_statement
   24              | return_statement
   25              | nop_statement
   26              | var_statement
   27              | global_statement

   28 foldable_statement: function_statement
   29                   | for_statement
   30                   | class_statement
   31                   | while_statement

   32 single_statement: expression_statement
   33                 | if_statement
   34                 | else_statement
   35                 | elif_statement
   36                 | for_statement
   37                 | while_statement
   38                 | break_statement
   39                 | continue_statement
   40                 | return_statement
   41                 | function_statement
   42                 | nop_statement
   43                 | var_statement
   44                 | global_statement
   45                 | class_statement
   46                 | error

   47 single_statement_no_semicolon: expression_statement
   48                              | if_statement
   49                              | for_statement
   50                              | while_statement
   51                              | do_while_statement
   52                              | null_statement

   53 null_statement: /* empty */

   54 nop_statement: NOP

   55 statement_block: LEFT_BRACE block_list RIGHT_BRACE
   56                | LEFT_BRACE RIGHT_BRACE

   57 block_list: single_statement
   58           | block_list single_statement

   59 expression_statement: expression

   60 expression: value_expression
   61           | lvalue_operation_expression
   62           | unary_expression
   63           | binary_expression
   64           | array_expression
   65           | shortcut_expression

   66 lvalue_operation_expression: assign_expression
   67                            | self_operation_expression

   68 assign_expression: lvalue_expression ASSIGN expression
   69                  | lvalue_expression ADD_ASSIGN expression
   70                  | lvalue_expression SUB_ASSIGN expression
   71                  | lvalue_expression MUL_ASSIGN expression
   72                  | lvalue_expression DIV_ASSIGN expression
   73                  | lvalue_expression MOD_ASSIGN expression

   74 self_operation_expression: INCREMENT lvalue_expression
   75                          | DECREMENT lvalue_expression
   76                          | lvalue_expression INCREMENT
   77                          | lvalue_expression DECREMENT

   78 unary_expression: SUB expression
   79                 | ADD expression
   80                 | LEFT_PAREN expression RIGHT_PAREN
   81                 | NOT expression
   82                 | BIT_NOT expression

   83 binary_expression: expression ADD expression
   84                  | expression SUB expression
   85                  | expression MUL expression
   86                  | expression DIV expression
   87                  | expression MOD expression
   88                  | expression AND expression
   89                  | expression OR expression
   90                  | expression XOR expression
   91                  | expression EQ expression
   92                  | expression NE expression
   93                  | expression GT expression
   94                  | expression GE expression
   95                  | expression LT expression
   96                  | expression LE expression
   97                  | expression BIT_AND expression
   98                  | expression BIT_OR expression
   99                  | expression BIT_XOR expression
  100                  | expression QM expression COLON expression

  101 shortcut_expression: SHORTCUT_PRINTLN element_list

  102 value_expression: INT_LTR
  103                 | FLT_LTR
  104                 | BLN_LTR
  105                 | STR_LTR
  106                 | NLL_LTR
  107                 | function_expression
  108                 | lvalue_expression

  109 lvalue_expression: IDENTIFER
