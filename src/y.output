Grammar

    0 $accept: statement $end

    1 statement: IMPORT STR_LTR

    2 @1: /* empty */

    3 statement: statement close_execute_last_statement @1 single_statement LF check_indent build_statement_stack execute_single_statement
    4          | statement INDENT single_statement LF check_indent build_statement_stack
    5          | statement LF close_execute_statement
    6          | statement END_FILE close_execute_last_statement
    7          | error
    8          | /* empty */
    9          | END_FILE

   10 check_indent: /* empty */

   11 build_statement_stack: /* empty */

   12 close_execute_statement: /* empty */

   13 close_execute_last_statement: /* empty */

   14 execute_single_statement: /* empty */

   15 single_statement: expression_statement
   16                 | if_statement
   17                 | else_statement
   18                 | elseif_statement
   19                 | for_statement
   20                 | while_statement
   21                 | break_statement
   22                 | continue_statement
   23                 | return_statement
   24                 | function_statement
   25                 | nop_statement
   26                 | var_statement
   27                 | global_statement
   28                 | class_statement
   29                 | error

   30 single_statement_no_semicolon: expression_statement
   31                              | if_statement
   32                              | for_statement
   33                              | while_statement
   34                              | do_while_statement
   35                              | null_statement

   36 null_statement: /* empty */

   37 nop_statement: NOP

   38 statement_block: LEFT_BRACE block_list RIGHT_BRACE
   39                | LEFT_BRACE RIGHT_BRACE

   40 block_list: single_statement
   41           | block_list single_statement

   42 expression_statement: expression

   43 expression: value_expression
   44           | lvalue_operation_expression
   45           | unary_expression
   46           | binary_expression
   47           | array_expression
   48           | shortcut_expression

   49 lvalue_operation_expression: assign_expression
   50                            | self_operation_expression

   51 assign_expression: lvalue_expression ASSIGN expression
   52                  | lvalue_expression ADD_ASSIGN expression
   53                  | lvalue_expression SUB_ASSIGN expression
   54                  | lvalue_expression MUL_ASSIGN expression
   55                  | lvalue_expression DIV_ASSIGN expression
   56                  | lvalue_expression MOD_ASSIGN expression

   57 self_operation_expression: INCREMENT lvalue_expression
   58                          | DECREMENT lvalue_expression
   59                          | lvalue_expression INCREMENT
   60                          | lvalue_expression DECREMENT

   61 unary_expression: SUB expression
   62                 | ADD expression
   63                 | LEFT_PAREN expression RIGHT_PAREN
   64                 | NOT expression
   65                 | BIT_NOT expression

   66 binary_expression: expression ADD expression
   67                  | expression SUB expression
   68                  | expression MUL expression
   69                  | expression DIV expression
   70                  | expression MOD expression
   71                  | expression AND expression
   72                  | expression OR expression
   73                  | expression XOR expression
   74                  | expression EQ expression
   75                  | expression NE expression
   76                  | expression GT expression
   77                  | expression GE expression
   78                  | expression LT expression
   79                  | expression LE expression
   80                  | expression BIT_AND expression
   81                  | expression BIT_OR expression
   82                  | expression BIT_XOR expression
   83                  | expression QM expression COLON expression

   84 shortcut_expression: SHORTCUT_PRINTLN element_list

   85 value_expression: INT_LTR
   86                 | FLT_LTR
   87                 | BLN_LTR
   88                 | STR_LTR
   89                 | NLL_LTR
   90                 | function_expression
   91                 | lvalue_expression

   92 lvalue_expression: IDENTIFER
   93                  | lvalue_expression DOT IDENTIFER
   94                  | lvalue_expression evaluate_list
   95                  | lvalue_expression DOT function_expression

   96 array_expression: LEFT_QUAD element_list RIGHT_QUAD
   97                 | LEFT_QUAD RIGHT_QUAD

   98 element_list: expression
   99             | element_list COMMA expression

  100 var_statement: VAR assign_list
  101              | SHARED VAR assign_list

  102 global_statement: GLOBAL assign_list

  103 assign_list: IDENTIFER
  104            | IDENTIFER ASSIGN expression
  105            | assign_list COMMA IDENTIFER
  106            | assign_list COMMA IDENTIFER ASSIGN expression

  107 function_expression: IDENTIFER LEFT_PAREN argument_list RIGHT_PAREN
  108                    | IDENTIFER LEFT_PAREN RIGHT_PAREN

  109 argument_list: expression
  110              | IDENTIFER COLON expression
  111              | argument_list COMMA expression
  112              | argument_list COMMA IDENTIFER COLON expression

  113 parameter_list: IDENTIFER
  114               | IDENTIFER ASSIGN expression
  115               | parameter_list COMMA IDENTIFER
  116               | parameter_list COMMA IDENTIFER ASSIGN expression

  117 evaluate_list: LEFT_QUAD expression RIGHT_QUAD
  118              | LEFT_QUAD expression COLON expression RIGHT_QUAD
  119              | LEFT_QUAD expression COLON expression COLON RIGHT_QUAD
  120              | LEFT_QUAD expression COLON expression COLON expression RIGHT_QUAD
  121              | LEFT_QUAD expression COLON RIGHT_QUAD
  122              | LEFT_QUAD expression COLON COLON RIGHT_QUAD
  123              | LEFT_QUAD expression COLON COLON expression RIGHT_QUAD
  124              | LEFT_QUAD COLON expression RIGHT_QUAD
  125              | LEFT_QUAD COLON expression COLON RIGHT_QUAD
  126              | LEFT_QUAD COLON expression COLON expression RIGHT_QUAD
  127              | LEFT_QUAD COLON COLON RIGHT_QUAD
  128              | evaluate_list LEFT_QUAD expression RIGHT_QUAD
  129              | evaluate_list LEFT_QUAD expression COLON expression RIGHT_QUAD
  130              | evaluate_list LEFT_QUAD expression COLON expression COLON RIGHT_QUAD
  131              | evaluate_list LEFT_QUAD expression COLON expression COLON expression RIGHT_QUAD
  132              | evaluate_list LEFT_QUAD expression COLON RIGHT_QUAD
  133              | evaluate_list LEFT_QUAD expression COLON COLON RIGHT_QUAD
  134              | evaluate_list LEFT_QUAD expression COLON COLON expression RIGHT_QUAD
  135              | evaluate_list LEFT_QUAD COLON expression RIGHT_QUAD
  136              | evaluate_list LEFT_QUAD COLON expression COLON RIGHT_QUAD
  137              | evaluate_list LEFT_QUAD COLON expression COLON expression RIGHT_QUAD
  138              | evaluate_list LEFT_QUAD COLON COLON RIGHT_QUAD

  139 if_statement: IF expression

  140 else_statement: ELSE

  141 elseif_statement: ELSEIF expression

  142 for_statement: FOR single_statement_no_semicolon SEMICOLON expression_statement SEMICOLON single_statement_no_semicolon
  143              | FOR single_statement_no_semicolon COLON expression_statement COLON single_statement_no_semicolon

  144 while_statement: WHILE expression
  145                | WHILE

  146 do_while_statement: DO structure_statement WHILE LEFT_PAREN expression_statement RIGHT_PAREN SEMICOLON

  147 break_statement: BREAK
  148                | BREAK LEFT_PAREN expression RIGHT_PAREN

  149 continue_statement: CONTINUE
  150                   | CONTINUE LEFT_PAREN expression RIGHT_PAREN

  151 structure_statement: single_statement
  152                    | statement_block

  153 function_statement: FUNC IDENTIFER LEFT_PAREN parameter_list RIGHT_PAREN
  154                   | FUNC IDENTIFER LEFT_PAREN RIGHT_PAREN
  155                   | SHARED FUNC IDENTIFER LEFT_PAREN parameter_list RIGHT_PAREN
  156                   | SHARED FUNC IDENTIFER LEFT_PAREN RIGHT_PAREN

  157 class_statement: CLASS IDENTIFER

  158 return_statement: RETURN
  159                 | RETURN expression


