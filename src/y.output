Grammar

    0 $accept: begin_stream $end

    1 begin_stream: import_statement
    2             | statement

    3 import_statement: IMPORT STR_LTR

    4 statement: statement NOINDENT monostatement enclose_statement_stack build_single_statement_stack execute_single_statement LF
    5          | statement NOINDENT foldable_statement build_statement_stack LF
    6          | statement INDENT single_statement LF check_indent build_statement_stack

    7 @1: /* empty */

    8 statement: statement close_execute_last_statement @1 single_statement LF check_indent build_statement_stack execute_single_statement
    9          | statement INDENT single_statement LF check_indent build_statement_stack
   10          | statement LF close_execute_statement
   11          | statement END_FILE close_execute_last_statement
   12          | error
   13          | LF
   14          | END_FILE

   15 check_indent: /* empty */

   16 enclose_statement_stack: /* empty */

   17 build_statement_stack: /* empty */

   18 build_single_statement_stack: /* empty */

   19 close_execute_statement: /* empty */

   20 close_execute_last_statement: /* empty */

   21 execute_single_statement: /* empty */

   22 monostatement: expression_statement
   23              | break_statement
   24              | continue_statement
   25              | return_statement
   26              | nop_statement
   27              | var_statement
   28              | global_statement

   29 foldable_statement: function_statement
   30                   | for_statement
   31                   | class_statement
   32                   | while_statement

   33 single_statement: expression_statement
   34                 | if_statement
   35                 | else_statement
   36                 | elif_statement
   37                 | for_statement
   38                 | while_statement
   39                 | break_statement
   40                 | continue_statement
   41                 | return_statement
   42                 | function_statement
   43                 | nop_statement
   44                 | var_statement
   45                 | global_statement
   46                 | class_statement
   47                 | error

   48 single_statement_no_semicolon: expression_statement
   49                              | if_statement
   50                              | for_statement
   51                              | while_statement
   52                              | do_while_statement
   53                              | null_statement

   54 null_statement: /* empty */

   55 nop_statement: NOP

   56 statement_block: LEFT_BRACE block_list RIGHT_BRACE
   57                | LEFT_BRACE RIGHT_BRACE

   58 block_list: single_statement
   59           | block_list single_statement

   60 expression_statement: expression

   61 expression: value_expression
   62           | lvalue_operation_expression
   63           | unary_expression
   64           | binary_expression
   65           | array_expression
   66           | shortcut_expression

   67 lvalue_operation_expression: assign_expression
   68                            | self_operation_expression

   69 assign_expression: lvalue_expression ASSIGN expression
   70                  | lvalue_expression ADD_ASSIGN expression
   71                  | lvalue_expression SUB_ASSIGN expression
   72                  | lvalue_expression MUL_ASSIGN expression
   73                  | lvalue_expression DIV_ASSIGN expression
   74                  | lvalue_expression MOD_ASSIGN expression

   75 self_operation_expression: INCREMENT lvalue_expression
   76                          | DECREMENT lvalue_expression
   77                          | lvalue_expression INCREMENT
   78                          | lvalue_expression DECREMENT

   79 unary_expression: SUB expression
   80                 | ADD expression
   81                 | LEFT_PAREN expression RIGHT_PAREN
   82                 | NOT expression
   83                 | BIT_NOT expression

   84 binary_expression: expression ADD expression
   85                  | expression SUB expression
   86                  | expression MUL expression
   87                  | expression DIV expression
   88                  | expression MOD expression
   89                  | expression AND expression
   90                  | expression OR expression
   91                  | expression XOR expression
   92                  | expression EQ expression
   93                  | expression NE expression
