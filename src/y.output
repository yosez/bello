  155              | evaluate_list LEFT_QUAD COLON COLON RIGHT_QUAD

  156 if_statement: IF expression

  157 else_statement: ELSE

  158 elif_statement: ELIF expression

  159 for_statement: FOR single_statement_no_semicolon SEMICOLON expression_statement SEMICOLON single_statement_no_semicolon
  160              | FOR single_statement_no_semicolon COLON expression_statement COLON single_statement_no_semicolon

  161 while_statement: WHILE expression
  162                | WHILE

  163 do_while_statement: DO structure_statement WHILE LEFT_PAREN expression_statement RIGHT_PAREN SEMICOLON

  164 break_statement: BREAK
  165                | BREAK LEFT_PAREN expression RIGHT_PAREN

  166 continue_statement: CONTINUE
  167                   | CONTINUE LEFT_PAREN expression RIGHT_PAREN

  168 structure_statement: single_statement
